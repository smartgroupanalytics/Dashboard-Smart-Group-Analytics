{
  "name": "RetrabalhoAnalise",
  "type": "object",
  "properties": {
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data do retrabalho (YYYY-MM-DD)"
    },
    "op": {
      "type": "string",
      "description": "N\u00famero da OP"
    },
    "produto": {
      "type": "string",
      "description": "Produto"
    },
    "descricao_retrabalho": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do retrabalho"
    },
    "metros": {
      "type": "number",
      "description": "Metros de retrabalho"
    },
    "maquina": {
