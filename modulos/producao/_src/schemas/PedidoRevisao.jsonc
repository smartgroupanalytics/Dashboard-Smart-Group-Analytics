{
  "name": "PedidoRevisao",
  "type": "object",
  "properties": {
    "op": {
      "type": "string",
      "description": "N\u00famero da OP (coluna A)"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data do apontamento (YYYY-MM-DD)"
    },
    "qtd_revisada": {
      "type": "number",
      "description": "Quantidade aprovada/revisada em metros (coluna K)"
    },
    "classificacao": {
      "type": "string",
      "enum": [
        "VENDA",
        "BENEFICIAMENTO",
        "ESTOQUE"
      ],
      "description": "Tipo de produ\u00e7\u00e3o (coluna P - Descr.Tp.produ\u00e7\u00e3o)"
    }
  },
  "required": [
    "op",
    "data"
  ]
}