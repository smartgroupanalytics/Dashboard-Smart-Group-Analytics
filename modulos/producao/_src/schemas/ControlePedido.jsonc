{
  "name": "ControlePedido",
  "type": "object",
  "properties": {
    "op": {
      "type": "string",
      "description": "N\u00ba da OP"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do produto"
    },
    "metros": {
      "type": "number",
      "description": "Metragem do pedido"
    },
    "data_entrada": {
      "type": "string",
      "format": "date",
      "description": "Data de entrada do pedido (YYYY-MM-DD)"
    },
    "data_entrega": {
      "type": "string",
      "format": "date",
      "description": "Data para entrega (YYYY-MM-DD)"
    },
    "complicador": {
      "type": "string",
      "description": "Complicador (pessoa/motivo)"
    },
    "status": {
      "type": "string",
      "enum": [
        "Aberto",
        "Em Produ\u00e7\u00e3o",
        "Conclu\u00eddo",
        "Atrasado",
        "Cancelado"
      ],
      "default": "Aberto"
    }
  },
  "required": [
    "op"
  ]
}