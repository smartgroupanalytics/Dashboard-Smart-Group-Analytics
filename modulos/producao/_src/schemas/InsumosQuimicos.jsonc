      "type": "string",
      "description": "Descri\u00e7\u00e3o do Produto"
    },
    "descricao_insumo": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do Insumo"
    },
    "qtde_prevista": {
      "type": "number",
      "description": "Qtde Prevista"
    },
    "qtde_realizada": {
      "type": "number",
      "description": "Qtde Realizada"
    },
    "valor_previsto": {
      "type": "number",
      "description": "Valor Previsto (R$)"
    },
    "valor_realizado": {
      "type": "number",
      "description": "Valor Realizado (R$)"
    },
    "previsto": {
