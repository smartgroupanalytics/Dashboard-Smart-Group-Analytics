      "type": "number",
      "description": "Pedido Beira Rio (metros)"
    },
    "pedidos_outros": {
      "type": "number",
      "description": "Pedidos Outros (metros)"
    },
    "estoque_beira_rio": {
      "type": "number",
      "description": "Estoque Beira Rio (metros)"
    },
    "estoque_stk": {
      "type": "number",
      "description": "Estoque STK (metros)"
    },
    "estoque_outros": {
      "type": "number",
      "description": "Estoque Outros (metros)"
    },
    "falta_programar_total": {
      "type": "number",
      "description": "Total Falta Programar (metros)"
    },
