{
  "name": "RecorrenciaPedido",
  "type": "object",
  "properties": {
    "codigo_produto": {
      "type": "string",
      "description": "C\u00f3digo do produto"
    },
    "descricao_produto": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do produto"
    },
    "num_op": {
      "type": "string",
      "description": "N\u00famero da OP (coluna C)"
    },
    "metragem": {
      "type": "number",
      "description": "Metragem do pedido"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data do pedido (YYYY-MM-DD)"
    },
    "mes": {
      "type": "number",
      "description": "M\u00eas derivado da data (1-12)"
    },
    "ano": {
      "type": "number",
      "description": "Ano derivado da data"
    }
  },
  "required": [
    "codigo_produto",
    "data"
  ]
}