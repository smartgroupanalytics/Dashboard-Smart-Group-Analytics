      "type": "number",
      "description": "Metragem programada"
    },
    "entrega": {
      "type": "string",
      "description": "Entrega (data formatada dd/mm/yyyy)"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data de entrega (YYYY-MM-DD) derivada da coluna Entrega"
    },
    "situacao": {
      "type": "string",
      "description": "Situa\u00e7\u00e3o (Pronto / A Fazer)"
