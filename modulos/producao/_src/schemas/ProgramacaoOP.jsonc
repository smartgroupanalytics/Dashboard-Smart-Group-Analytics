{
  "name": "ProgramacaoOP",
  "type": "object",
  "properties": {
    "maquina": {
      "type": "string",
      "description": "Nome da m\u00e1quina (Gravadora, JR, Estampa 1, Estampa 2, GR)"
    },
    "num_op": {
      "type": "string",
      "description": "N\u00ba da OP programada"
    },
    "produto": {
      "type": "string",
      "description": "Produto"
    },
